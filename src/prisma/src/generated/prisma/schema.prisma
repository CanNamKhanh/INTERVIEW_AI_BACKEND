model IndustryCategory {
  id          String  @id @default(uuid())
  name        String  @unique // "Software Engineering", "Marketing", "Finance"...
  slug        String  @unique // "software-engineering", "marketing"
  description String?

  interviews Interview[]

  @@map("industry_categories")
}

model Feedback {
  id String @id @default(uuid())

  interviewId String    @unique
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  overallScore Int?

  strengths  String? @db.Text
  weaknesses String? @db.Text
  summary    String? @db.Text

  createdAt DateTime @default(now())

  @@map("feedbacks")
}

enum InterviewStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Interview {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?
  category   IndustryCategory? @relation(fields: [categoryId], references: [id])

  title    String
  position String
  level    String

  yearsOfExperience Int?
  type              InterviewType

  language       String @default("en")
  targetDuration Int?
  questionCount  Int?

  status InterviewStatus @default(ACTIVE)

  messages Message[]
  feedback Feedback?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("interviews")
}

enum InterviewType {
  TECHNICAL
  BEHAVIORAL
  SYSTEM_DESIGN
  HR
  MIXED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Message {
  id String @id @default(uuid())

  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  role    MessageRole
  content String      @db.Text

  createdAt DateTime @default(now())

  @@map("messages")
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String @id @default(uuid())
  name         String
  email        String @unique
  passwordHash String

  interviews Interview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
